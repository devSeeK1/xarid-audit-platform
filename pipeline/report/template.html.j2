{% if standalone %}<!doctype html>
<html lang="uz">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
{% endif %}<title>Xarid Audit Hisoboti</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+Condensed:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap">
<style>
/* Layout: auditor's working paper — summary strip first, then evidence sections in one readable column; wide tables scroll in their own frames. */
:root {
  --paper: #f4f7f6; --surface: #ffffff; --ink: #14222a; --ink-2: #4a5a63; --muted: #6f8088;
  --line: #dbe3e1; --line-strong: #b9c6c3; --accent: #0e6b70; --accent-strong: #08494d; --accent-wash: rgba(14,107,112,.10);
  --notice-bg: #fff3d1; --notice-ink: #5a4300;
  --sev-crit: #a8231b; --sev-high: #b9450d; --sev-mid: #8a5d00; --sev-low: #3f7547;
  --sev-crit-bg: #fbe4e2; --sev-high-bg: #fde9dc; --sev-mid-bg: #f8edd3; --sev-low-bg: #e3f0e4;
  --f-display: "IBM Plex Sans Condensed", "Arial Narrow", "Roboto Condensed", sans-serif;
  --f-body: "IBM Plex Sans", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  --f-mono: "IBM Plex Mono", ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
  color-scheme: light;
}
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) {
  --paper: #0e161a; --surface: #142026; --ink: #e4edef; --ink-2: #a6b6bc; --muted: #7f9198;
  --line: #24343b; --line-strong: #364a52; --accent: #4fb2b4; --accent-strong: #8fd3d4; --accent-wash: rgba(79,178,180,.14);
  --notice-bg: #3a2f10; --notice-ink: #f3dc9b;
  --sev-crit: #ff8a80; --sev-high: #ffab76; --sev-mid: #e9c46a; --sev-low: #8fcf97;
  --sev-crit-bg: #3d1a18; --sev-high-bg: #3b2416; --sev-mid-bg: #352b12; --sev-low-bg: #1b2f1e;
  color-scheme: dark;
} }
:root[data-theme="dark"] {
  --paper: #0e161a; --surface: #142026; --ink: #e4edef; --ink-2: #a6b6bc; --muted: #7f9198;
  --line: #24343b; --line-strong: #364a52; --accent: #4fb2b4; --accent-strong: #8fd3d4; --accent-wash: rgba(79,178,180,.14);
  --notice-bg: #3a2f10; --notice-ink: #f3dc9b;
  --sev-crit: #ff8a80; --sev-high: #ffab76; --sev-mid: #e9c46a; --sev-low: #8fcf97;
  --sev-crit-bg: #3d1a18; --sev-high-bg: #3b2416; --sev-mid-bg: #352b12; --sev-low-bg: #1b2f1e;
  color-scheme: dark;
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--paper); color: var(--ink); font: 15px/1.55 var(--f-body); }
.wrap { max-width: 1080px; margin: 0 auto; padding: 0 20px; padding-block: 28px 64px; display: grid; gap: 40px; }
h1, h2, h3 { font-family: var(--f-display); text-wrap: balance; margin: 0; letter-spacing: -.005em; }
h1 { font-size: clamp(28px, 4.2vw, 40px); font-weight: 700; line-height: 1.1; }
h2 { font-size: 22px; font-weight: 600; }
h3 { font-size: 16px; font-weight: 600; }
p { margin: 0; max-width: 68ch; }
.eyebrow { font: 500 12px/1 var(--f-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
.mono { font-family: var(--f-mono); font-size: .92em; }
.num { font-variant-numeric: tabular-nums; }
.muted { color: var(--muted); }
section { display: grid; gap: 16px; min-width: 0; }
.section-head { display: grid; gap: 6px; border-top: 1px solid var(--line-strong); padding-top: 14px; }
.section-head p { color: var(--ink-2); }

header.top { display: grid; gap: 14px; }
.meta { display: flex; flex-wrap: wrap; gap: 6px 20px; color: var(--ink-2); font-size: 13px; }
.meta b { font-weight: 500; color: var(--ink); }
.notice { background: var(--notice-bg); color: var(--notice-ink); border-radius: 6px; padding: 10px 14px; font-size: 14px; }

.summary { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 2fr); gap: 16px; align-items: stretch; }
.hero { background: var(--surface); border: 1px solid var(--line); border-radius: 8px; padding: 20px; display: grid; gap: 8px; align-content: start; }
.hero .value { font: 600 clamp(36px, 5vw, 52px)/1.05 var(--f-body); color: var(--ink); }
.hero .value small { font-size: .42em; font-weight: 500; color: var(--ink-2); }
.tiles { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: 8px; overflow: hidden; }
.tile { background: var(--surface); padding: 16px 18px; display: grid; gap: 4px; }
.tile .label { font-size: 13px; color: var(--ink-2); }
.tile .value { font-size: 26px; font-weight: 600; line-height: 1.15; }
.tile .sub { font-size: 13px; color: var(--muted); }

.panel h3 { margin-bottom: 10px; }
.panel { background: var(--surface); border: 1px solid var(--line); border-radius: 8px; padding: 16px 18px; min-width: 0; }
.chart { width: 100%; height: auto; display: block; overflow: visible; }
.chart .grid { stroke: var(--line); stroke-width: 1; }
.chart .axis { stroke: var(--line-strong); stroke-width: 1; }
.chart .bar { fill: var(--accent); transition: fill .15s; }
.chart .hit { fill: transparent; }
.chart .mark:hover .bar { fill: var(--accent-strong); }
.chart .lab { fill: var(--ink); font: 13px var(--f-body); }
.chart .val { fill: var(--ink-2); font: 12px var(--f-mono); }
.chart .tick { fill: var(--muted); font: 11px var(--f-mono); }
.chart .area { fill: var(--accent-wash); }
.chart .line { fill: none; stroke: var(--accent); stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
.chart .dot, .chart .xdot { fill: var(--accent); stroke: var(--surface); stroke-width: 2; }
.chart .xhair { stroke: var(--line-strong); stroke-width: 1; }
.chart .hitarea { fill: transparent; cursor: crosshair; }
.chart-wrap { position: relative; }
.tip { position: absolute; pointer-events: none; background: var(--ink); color: var(--paper); font: 12px var(--f-mono); padding: 5px 8px; border-radius: 4px; white-space: nowrap; transform: translate(-50%, -130%); }
.grid-2 { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16px; }

.table-frame { overflow-x: auto; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); }
table { border-collapse: collapse; width: 100%; font-size: 14px; }
th, td { text-align: left; padding: 9px 12px; border-bottom: 1px solid var(--line); vertical-align: top; }
th { font: 500 12px/1.3 var(--f-mono); text-transform: uppercase; letter-spacing: .06em; color: var(--muted); background: var(--surface); white-space: nowrap; }
tr:last-child td { border-bottom: 0; }
td.r, th.r { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
td .desc { color: var(--ink-2); font-size: 13px; margin-top: 2px; }

.sev { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 500; padding: 2px 8px 2px 6px; border-radius: 999px; white-space: nowrap; }
.sev::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
.sev-crit { color: var(--sev-crit); background: var(--sev-crit-bg); }
.sev-high { color: var(--sev-high); background: var(--sev-high-bg); }
.sev-mid { color: var(--sev-mid); background: var(--sev-mid-bg); }
.sev-low { color: var(--sev-low); background: var(--sev-low-bg); }
.chip { display: inline-block; font: 500 11px/1.6 var(--f-mono); padding: 0 6px; border: 1px solid var(--line-strong); border-radius: 4px; color: var(--ink-2); margin: 1px 2px 1px 0; }
.score { font: 600 15px var(--f-mono); }

.samples { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
.sample { background: var(--surface); border: 1px solid var(--line); border-radius: 8px; padding: 14px 16px; display: grid; gap: 10px; align-content: start; min-width: 0; }
.sample-head { display: flex; flex-wrap: wrap; gap: 6px 10px; align-items: baseline; justify-content: space-between; }
.finding { border-top: 1px solid var(--line); padding-top: 8px; display: grid; gap: 4px; font-size: 13px; min-width: 0; }
.finding .ids { display: flex; flex-wrap: wrap; gap: 4px 12px; justify-content: space-between; }
.finding dl { margin: 0; display: flex; flex-wrap: wrap; gap: 2px 14px; color: var(--ink-2); }
.finding dt { display: inline; color: var(--muted); }
.finding dd { display: inline; margin: 0 0 0 4px; color: var(--ink); overflow-wrap: anywhere; }
.empty { color: var(--muted); font-size: 13px; }

.ok { color: var(--sev-low); font-weight: 600; }
.bad { color: var(--sev-crit); font-weight: 600; }
footer { color: var(--muted); font-size: 13px; border-top: 1px solid var(--line); padding-top: 16px; display: grid; gap: 6px; }

@media (max-width: 760px) {
  .summary, .grid-2, .samples { grid-template-columns: minmax(0, 1fr); }
  .tiles { grid-template-columns: minmax(0, 1fr); }
}
@media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
</style>
{% if standalone %}</head>
<body>
{% endif %}
{% set sev = {"Juda yuqori": "sev-crit", "Yuqori": "sev-high", "O'rta": "sev-mid", "Past": "sev-low"} %}
<div class="wrap">

<header class="top">
  <span class="eyebrow">Davlat xaridlari audit-analitika platformasi</span>
  <h1>Xarid Audit Hisoboti</h1>
  <div class="meta">
    <span>Davr: <b class="num">{{ period }}</b></span>
    <span>Run ID: <b class="mono">{{ run.id }}</b></span>
    <span>Rejim: <b>{{ run.mode }}</b></span>
    <span>Ishlov vaqti: <b class="num">{{ run.duration }} s</b></span>
    <span>Shakllantirildi: <b class="num">{{ generated }}</b></span>
  </div>
  <p class="notice">Namoyish uchun <b>sintetik ma'lumotlar</b>. Barcha tashkilot nomlari, STIR va PINFL raqamlari tasodifiy yaratilgan va hech qanday real shaxs yoki tashkilotga tegishli emas.</p>
</header>

<section aria-label="Qisqa xulosa">
  <div class="summary">
    <div class="hero">
      <span class="eyebrow">Xavf ostidagi summa</span>
      <div class="value num">{{ hero_risk.split(' ')[0] }} <small>{{ hero_risk.split(' ', 1)[1] }}</small></div>
      <p class="muted">8 ta audit qoidasi topgan barcha holatlar bo'yicha shubhali summaning yig'indisi. Har bir topilma auditor tomonidan alohida tekshirilishi kerak.</p>
    </div>
    <div class="tiles">
      {% for label, value, sub in kpi %}
      <div class="tile"><span class="label">{{ label }}</span><span class="value num">{{ value }}</span><span class="sub">{{ sub }}</span></div>
      {% endfor %}
    </div>
  </div>
</section>

<section>
  <div class="section-head">
    <h2>Topilmalar qoidalar bo'yicha</h2>
    <p>Har bir qoida alohida SQL fayl sifatida yozilgan, chegaralari sozlamalar faylidan olinadi.</p>
  </div>
  <div class="panel">{{ chart_rules | safe }}</div>
  <div class="table-frame">
    <table>
      <thead><tr><th>Kod</th><th>Qoida</th><th>Daraja</th><th class="r">Ball</th><th class="r">Topildi</th><th class="r">Xavf ostidagi summa</th></tr></thead>
      <tbody>
      {% for r in rules %}
      <tr>
        <td class="mono">{{ r.code }}</td>
        <td><div>{{ r.name }}</div><div class="desc">{{ r.desc }}</div></td>
        <td><span class="sev {{ sev[r.severity] }}">{{ r.severity }}</span></td>
        <td class="r">{{ r.weight }}</td>
        <td class="r">{{ r.n }}</td>
        <td class="r">{{ r.amount }}</td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</section>

<section>
  <div class="section-head">
    <h2>Eng yuqori xavfli buyurtmachilar</h2>
    <p>Xavf balli — har bir topilma qoidasining og'irligi yig'indisi. Bir nechta turdagi qoidalar ostiga tushgan tashkilotlar birinchi navbatda tekshiriladi.</p>
  </div>
  <div class="table-frame">
    <table>
      <thead><tr><th>Buyurtmachi</th><th>Hudud · soha</th><th>Qoidalar</th><th class="r">Topilma</th><th class="r">Ball</th><th class="r">Xavf ostidagi summa</th></tr></thead>
      <tbody>
      {% for b in buyers %}
      <tr>
        <td><span class="mono">{{ b.id }}</span></td>
        <td>{{ b.region }}<div class="desc">{{ b.sector }}</div></td>
        <td>{% for c in b.rules %}<span class="chip">{{ c }}</span>{% endfor %}</td>
        <td class="r">{{ b.findings }}</td>
        <td class="r"><span class="score">{{ b.score }}</span></td>
        <td class="r">{{ b.amount }}</td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</section>

<section>
  <div class="section-head">
    <h2>Hududlar va dinamika</h2>
  </div>
  <div class="panel"><h3>Xavf ostidagi summa hududlar bo'yicha, mlrd so'm</h3>{{ chart_regions | safe }}</div>
  <div class="panel chart-wrap"><h3>Oylik shartnomalar hajmi, mlrd so'm</h3>{{ chart_monthly | safe }}<div class="tip" hidden></div></div>
</section>

<section>
  <div class="section-head">
    <h2>Namuna topilmalar</h2>
    <p>Har bir qoida bo'yicha summasi eng katta uchta holat. To'liq ro'yxat omborning <span class="mono">audit.findings</span> jadvalida.</p>
  </div>
  <div class="samples">
  {% for r in rules %}
    <div class="sample">
      <div class="sample-head"><h3><span class="mono">{{ r.code }}</span> {{ r.name }}</h3><span class="sev {{ sev[r.severity] }}">{{ r.severity }}</span></div>
      {% for s in r.samples %}
      <div class="finding">
        <div class="ids"><span class="mono">{{ s.buyer }} → STIR {{ s.stir }}</span><b class="num">{{ s.amount }}</b></div>
        <dl>{% for k, v in s.details %}<div><dt>{{ k }}</dt><dd class="num">{{ v }}</dd></div>{% endfor %}</dl>
      </div>
      {% else %}
      <p class="empty">Bu qoida bo'yicha topilma yo'q.</p>
      {% endfor %}
    </div>
  {% endfor %}
  </div>
</section>

<section>
  <div class="section-head">
    <h2>Ma'lumot sifati</h2>
    <p>Qoidaga to'g'ri kelmagan qatorlar o'chirilmaydi: ular sababi bilan karantin jadvaliga yoziladi va manba egasiga qaytariladi.</p>
  </div>
  <div class="grid-2">
    <div class="table-frame">
      <table>
        <thead><tr><th>Ma'lumotlar to'plami</th><th class="r">Kirdi</th><th class="r">O'tdi</th><th class="r">Karantin</th><th class="r">Sifat, %</th></tr></thead>
        <tbody>{% for s in stats %}<tr><td class="mono">{{ s.name }}</td><td class="r">{{ s.rows_in }}</td><td class="r">{{ s.rows_out }}</td><td class="r">{{ s.quarantined }}</td><td class="r">{{ s.pct }}</td></tr>{% endfor %}</tbody>
      </table>
    </div>
    <div class="table-frame">
      <table>
        <thead><tr><th>To'plam</th><th>Tekshiruv</th><th class="r">Qatorlar</th></tr></thead>
        <tbody>{% for c in checks %}<tr><td class="mono">{{ c.dataset }}</td><td>{{ c.name }}</td><td class="r">{{ c.n }}</td></tr>{% endfor %}</tbody>
      </table>
    </div>
  </div>
  {% if recon %}
  <div class="panel">
    <h3>Spark va DuckDB natijalarini solishtirish</h3>
    <p class="muted">Bir xil agregatsiya ikki mustaqil dvigatelda hisoblanib, natijalar qatorma-qator solishtirildi.</p>
    <table><tbody>{% for c in recon %}<tr><td>{{ c.name }}</td><td class="r">{% if c.n == 0 %}<span class="ok">0 farq</span>{% else %}<span class="bad">{{ c.n }} farq</span>{% endif %}</td></tr>{% endfor %}</tbody></table>
  </div>
  {% endif %}
</section>

<section>
  <div class="section-head">
    <h2>Kelib chiqishi va texnik jurnal</h2>
    <p>Har bir manbaning SHA-256 nazorat yig'indisi saqlanadi: hisobot qaysi aniq ma'lumotdan tuzilganini keyinchalik isbotlash mumkin.</p>
  </div>
  <div class="table-frame">
    <table>
      <thead><tr><th>Manba</th><th>Joylashuvi</th><th>SHA-256</th><th class="r">Qatorlar</th></tr></thead>
      <tbody>{% for l in lineage %}<tr><td class="mono">{{ l.source }}</td><td class="mono">{{ l.location }}</td><td class="mono" title="{{ l.sha }}">{{ l.sha_short }}…</td><td class="r">{{ l.rows }}</td></tr>{% endfor %}</tbody>
    </table>
  </div>
  <div class="table-frame">
    <table>
      <thead><tr><th>Bosqich</th><th class="r">Vaqt, s</th></tr></thead>
      <tbody>{% for t in timings %}<tr><td>{{ t.step }}</td><td class="r">{{ t.sec }}</td></tr>{% endfor %}</tbody>
    </table>
  </div>
</section>

<footer>
  <span>Python · Polars · DuckDB · Apache Spark · FastAPI · Jinja2</span>
  <span>Ishga tushirgan: <span class="mono">{{ run.by }}@{{ run.host }}</span> · holat: {{ run.status }}</span>
</footer>
</div>

<script>
(function () {
  document.querySelectorAll(".chart-wrap").forEach(function (wrap) {
    var svg = wrap.querySelector("svg.line-chart"), tip = wrap.querySelector(".tip");
    if (!svg || !tip) return;
    var pts = JSON.parse(svg.getAttribute("data-points"));
    var hair = svg.querySelector(".xhair"), dot = svg.querySelector(".xdot"), hit = svg.querySelector(".hitarea");
    function show(evt) {
      var pt = svg.createSVGPoint(); pt.x = evt.clientX; pt.y = evt.clientY;
      var p = pt.matrixTransform(svg.getScreenCTM().inverse());
      var best = pts[0];
      pts.forEach(function (q) { if (Math.abs(q.x - p.x) < Math.abs(best.x - p.x)) best = q; });
      hair.setAttribute("x1", best.x); hair.setAttribute("x2", best.x); hair.setAttribute("visibility", "visible");
      dot.setAttribute("cx", best.x); dot.setAttribute("cy", best.y); dot.setAttribute("visibility", "visible");
      var box = svg.getBoundingClientRect(), wb = wrap.getBoundingClientRect(), k = box.width / svg.viewBox.baseVal.width;
      tip.textContent = best.t; tip.hidden = false;
      tip.style.left = (box.left - wb.left + best.x * k) + "px";
      tip.style.top = (box.top - wb.top + best.y * k) + "px";
    }
    function hide() { hair.setAttribute("visibility", "hidden"); dot.setAttribute("visibility", "hidden"); tip.hidden = true; }
    hit.addEventListener("pointermove", show);
    hit.addEventListener("pointerleave", hide);
  });
})();
</script>
{% if standalone %}</body>
</html>
{% endif %}
