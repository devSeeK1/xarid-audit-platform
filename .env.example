# Nusxa oling:  cp .env.example .env   va qiymatlarni o'zgartiring.
# .env fayli hech qachon Git'ga yuklanmaydi (.gitignore).

# G'aznachilik API'siga kirish tokeni (mock API ham shu tokenni tekshiradi)
TREASURY_API_TOKEN=change-me-to-a-long-random-token

# Shaxsiy ma'lumotlarni (PINFL) xeshlash uchun "tuz"
PII_SALT=change-me-to-another-long-random-string

# Ixtiyoriy: ma'lumotlar papkasi (standart: ./data)
# XARID_DATA_DIR=./data

# Ixtiyoriy: mock API'da tasodifiy 503 xatolar ulushi (retry mexanizmini sinash uchun)
# CHAOS_FAIL_RATE=0.05
